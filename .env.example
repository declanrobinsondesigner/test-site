# Copy to .env and fill in real values
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2025-01

PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
PUBLIC_SHOPIFY_API_VERSION=2025-01

# Exclusive Drops newsletter uses Storefront customerCreate.
# In Shopify Admin → Settings → Apps and sales channels → Headless / Storefront API:
# enable "unauthenticated_write_customers" (Customer Create).
# Also allow customer accounts: Settings → Customer accounts.
#
# Suggestion box posts to the store /contact form — ensure a store
# notification email is set under Settings → Notifications.
