---
import type { Product } from '../data/products';
import {
	getDisplayPrice,
	getCompareAtDisplayPrice,
	getFeaturedImage,
	getProductHref,
	getSizeBadgeLabel,
	resolveImageSrc,
	resolveImageWidth,
	resolveImageHeight,
} from '../data/products';

interface Props {
	products: Product[];
	/** Hide the whole block until this many products exist. */
	minProducts?: number;
	/** Max products to show in the strip. */
	limit?: number;
}

const { products, minProducts = 3, limit = 4 } = Astro.props;
const showcase = products.slice(0, limit);
const visible = showcase.length >= minProducts;
---

{
	visible && (
		<section class="section showcase" id="fresh-drops" aria-labelledby="showcase-title">
			<div class="container">
				<div class="section-header showcase-header">
					<p class="section-eyebrow">Fresh Off The Rack</p>
					<h2 class="section-title" id="showcase-title">In Stock Now</h2>
					<a class="showcase-all" href="/range">
						Shop all
					</a>
				</div>
				<div class="showcase-grid">
					{showcase.map((product) => {
						const image = getFeaturedImage(product);
						const compareAt = getCompareAtDisplayPrice(product);
						const src = resolveImageSrc(image.src);
						const sizeBadge = getSizeBadgeLabel(product.sizes);
						return (
							<a class="showcase-card" href={getProductHref(product)}>
								<div class="showcase-media">
									{sizeBadge && <span class="showcase-badge">{sizeBadge}</span>}
									<img
										src={src}
										width={resolveImageWidth(image.src, 480)}
										height={resolveImageHeight(image.src, 480)}
										alt={image.alt}
										loading="lazy"
									/>
								</div>
								<div class="showcase-body">
									<span class="showcase-vendor">{product.vendor}</span>
									<h3>{product.title}</h3>
									<span class="showcase-price">
										{getDisplayPrice(product)}
										{compareAt && <s>{compareAt}</s>}
									</span>
								</div>
							</a>
						);
					})}
				</div>
			</div>
		</section>
	)
}

<style>
	.showcase {
		background: transparent;
		border: none;
		box-shadow: none;
		padding: 3.25rem 0;
	}

	.container {
		max-width: 1140px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	.section-eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.2em;
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--bgs-crimson-bright);
		margin: 0 0 0.65rem;
	}

	.section-title {
		font-family: var(--bgs-font-display);
		font-size: clamp(1.55rem, 3.5vw, 2.15rem);
		color: var(--bgs-white);
		margin: 0;
		font-weight: 400;
		line-height: 1.2;
	}

	.showcase-header {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
		margin-bottom: 1.75rem;
		text-align: left;
	}

	.showcase-all {
		font-size: 0.8rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--bgs-crimson-bright);
		text-decoration: none;
		margin-left: auto;
	}

	.showcase-all:hover {
		color: var(--bgs-white);
	}

	.showcase-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1rem;
	}

	.showcase-card {
		display: flex;
		flex-direction: column;
		text-decoration: none;
		background: var(--bgs-charcoal);
		border: 1px solid var(--bgs-gray-dark);
		border-radius: 8px;
		overflow: hidden;
		transition:
			transform 0.2s,
			border-color 0.2s,
			box-shadow 0.2s;
	}

	.showcase-card:hover {
		transform: translateY(-4px);
		border-color: var(--bgs-crimson);
		box-shadow: 0 10px 28px rgba(0, 0, 0, 0.45);
	}

	.showcase-media {
		position: relative;
		aspect-ratio: 1;
		background: #121212;
		overflow: hidden;
	}

	.showcase-media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.45s ease;
	}

	.showcase-card:hover .showcase-media img {
		transform: scale(1.04);
	}

	.showcase-badge {
		position: absolute;
		top: 0.65rem;
		left: 0.65rem;
		z-index: 1;
		padding: 0.25rem 0.5rem;
		background: var(--bgs-crimson);
		color: var(--bgs-white);
		font-size: 0.65rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		border-radius: 3px;
	}

	.showcase-body {
		padding: 0.85rem 0.9rem 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}

	.showcase-vendor {
		font-size: 0.65rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--bgs-crimson-bright);
	}

	.showcase-body h3 {
		margin: 0;
		font-family: var(--bgs-font-display);
		font-size: 0.95rem;
		font-weight: 400;
		line-height: 1.3;
		color: var(--bgs-white);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.showcase-price {
		display: inline-flex;
		align-items: baseline;
		gap: 0.4rem;
		margin-top: 0.2rem;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--bgs-white);
		letter-spacing: 0.03em;
	}

	.showcase-price s {
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--bgs-gray);
	}

	@media (max-width: 900px) {
		.showcase {
			padding: 2.75rem 0;
		}

		.showcase-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 0.85rem;
		}
	}

	@media (max-width: 600px) {
		.container {
			padding: 0 1.15rem;
		}

		.showcase {
			padding: 2.35rem 0;
		}

		.showcase-header {
			margin-bottom: 1.25rem;
		}

		.showcase-body {
			padding: 0.7rem 0.75rem 0.85rem;
		}

		.showcase-body h3 {
			font-size: 0.88rem;
		}
	}
</style>
