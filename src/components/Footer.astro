---
import logo from '../assets/bgs-logo.png';
---

<footer class="site-footer">
	<div class="container footer-inner">
		<div class="footer-brand">
			<img src={logo.src} width="48" height="48" alt="" aria-hidden="true" />
			<div>
				<strong>Bad Girls Should</strong>
				<span>XL+ Alternative Attire · Grimsby, UK</span>
			</div>
		</div>
		<nav class="footer-nav" aria-label="Footer navigation">
			<a href="/range">Our Range</a>
			<a href="/mens">Men's</a>
			<a href="/womens">Women's</a>
			<a href="/brands">Brands</a>
			<a href="/events">Events</a>
			<a href="/#about">About</a>
		</nav>
		<nav class="footer-social" aria-label="Social and marketplaces">
			<a
				class="social-btn social-btn-ebay"
				href="https://www.ebay.co.uk/sch/i.html?_ssn=badgirlsshould&_oac=1"
				target="_blank"
				rel="noopener noreferrer"
			>
				eBay
			</a>
			<a
				class="social-btn social-btn-facebook"
				href="https://www.facebook.com/people/Bad-Girls-Should/100095156064533/"
				target="_blank"
				rel="noopener noreferrer"
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path>
				</svg>
				Facebook
			</a>
			<a
				class="social-btn social-btn-instagram"
				href="https://www.instagram.com/badgirlsshould"
				target="_blank"
				rel="noopener noreferrer"
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
				</svg>
				Instagram
			</a>
		</nav>
		<p class="footer-copy">&copy; {new Date().getFullYear()} Bad Girls Should. All rights reserved.</p>
	</div>
</footer>

<style>
	.container {
		max-width: 1140px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	.site-footer {
		background: transparent;
		border-top: none;
		padding: 2.5rem 0;
	}

	.footer-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem 1.5rem;
	}

	.footer-brand {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.footer-brand img {
		border-radius: 50%;
		border: 1px solid var(--bgs-gray-dark);
	}

	.footer-brand strong {
		display: block;
		font-family: var(--bgs-font-display);
		font-size: 0.95rem;
		color: var(--bgs-white);
		font-weight: 400;
	}

	.footer-brand span {
		font-size: 0.75rem;
		color: var(--bgs-gray);
		text-transform: uppercase;
		letter-spacing: 0.1em;
	}

	.footer-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 1.25rem;
	}

	.footer-nav a {
		text-decoration: none;
		color: var(--bgs-gray);
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		transition: color 0.2s;
	}

	.footer-nav a:hover {
		color: var(--bgs-crimson-bright);
	}

	.footer-social {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		width: 100%;
		justify-content: center;
	}

	.social-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		padding: 0.75rem 1.35rem;
		font-family: var(--bgs-font-body);
		font-size: 0.8rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		text-decoration: none;
		border-radius: 4px;
		border: 2px solid transparent;
		color: var(--bgs-white);
		transition:
			transform 0.15s,
			box-shadow 0.2s,
			background 0.2s,
			border-color 0.2s;
	}

	.social-btn:hover {
		transform: translateY(-2px);
	}

	.social-btn-ebay {
		background: var(--bgs-crimson);
		border-color: var(--bgs-crimson);
		box-shadow: 0 4px 16px var(--bgs-crimson-glow);
	}

	.social-btn-ebay:hover {
		background: var(--bgs-crimson-bright);
		border-color: var(--bgs-crimson-bright);
	}

	.social-btn-facebook {
		background: #1877f2;
		border-color: #1877f2;
	}

	.social-btn-facebook:hover {
		background: #166fe5;
		border-color: #166fe5;
	}

	.social-btn-instagram {
		background: linear-gradient(45deg, #f58529, #dd2a7b 50%, #8134af);
		border-color: #dd2a7b;
	}

	.social-btn-instagram:hover {
		filter: brightness(1.08);
	}

	.footer-copy {
		width: 100%;
		text-align: center;
		margin: 0.5rem 0 0;
		font-size: 0.75rem;
		color: #444;
		letter-spacing: 0.05em;
	}

	@media (max-width: 700px) {
		.footer-inner {
			flex-direction: column;
			align-items: flex-start;
		}

		.footer-nav,
		.footer-social {
			width: 100%;
		}

		.footer-social {
			justify-content: stretch;
		}

		.social-btn {
			flex: 1 1 100%;
		}

		.footer-copy {
			text-align: left;
		}
	}
</style>
