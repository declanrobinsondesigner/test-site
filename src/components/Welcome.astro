---
import heroImage from '../assets/hero.svg';
import htmlIcon from '../assets/html.svg';
import cssIcon from '../assets/css.svg';
import jsIcon from '../assets/js.svg';
import astroLogo from '../assets/astro.svg';

const topics = [
	{
		title: 'HTML',
		description: 'The bones of every website — headings, paragraphs, links, and images.',
		image: htmlIcon,
		color: '#ea580c',
	},
	{
		title: 'CSS',
		description: 'The paint and layout — colors, fonts, spacing, and making things look good.',
		image: cssIcon,
		color: '#2563eb',
	},
	{
		title: 'JavaScript',
		description: 'The interactivity — buttons that do things, animations, and dynamic content.',
		image: jsIcon,
		color: '#ca8a04',
	},
];
---

<div class="page">
	<header class="header">
		<img src={astroLogo.src} width="100" height="42" alt="Astro logo" />
		<span class="badge">Day 1</span>
	</header>

	<section class="hero">
		<div class="hero-text">
			<p class="eyebrow">Welcome to web development</p>
			<h1>You're building your first website!</h1>
			<p class="lead">
				This page lives at <code>src/pages/index.astro</code>. Edit that file, save, and watch
				your browser update automatically. That's the magic of a dev server.
			</p>
		</div>
		<img
			class="hero-image"
			src={heroImage.src}
			width="400"
			height="300"
			alt="Illustration of a person at a computer learning to code"
		/>
	</section>

	<section class="topics">
		<h2>Three things you'll learn</h2>
		<div class="topic-grid">
			{
				topics.map((topic) => (
					<article class="topic-card">
						<img src={topic.image.src} width="80" height="80" alt={`${topic.title} icon`} />
						<h3 style={`color: ${topic.color}`}>{topic.title}</h3>
						<p>{topic.description}</p>
					</article>
				))
			}
		</div>
	</section>

	<section class="tips">
		<h2>Quick tips for right now</h2>
		<ul>
			<li>
				<strong>Save often.</strong> Most changes appear instantly when you save a file.
			</li>
			<li>
				<strong>Break things on purpose.</strong> That's how you learn what each line does.
			</li>
			<li>
				<strong>Images go in <code>src/assets/</code></strong> and you import them at the top of
				an <code>.astro</code> file — just like this page does.
			</li>
		</ul>
	</section>

	<footer class="footer">
		<a href="https://docs.astro.build">Astro docs</a>
		<a href="https://developer.mozilla.org/en-US/docs/Learn">MDN Learn Web Dev</a>
		<a href="https://astro.build/chat">Astro Discord</a>
	</footer>
</div>

<style>
	.page {
		max-width: 960px;
		margin: 0 auto;
		padding: 2rem 1.5rem 3rem;
		font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
		color: #1e293b;
		line-height: 1.6;
	}

	.header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 2.5rem;
	}

	.badge {
		background: linear-gradient(135deg, #6366f1, #8b5cf6);
		color: white;
		font-size: 0.85rem;
		font-weight: 600;
		padding: 0.35rem 0.85rem;
		border-radius: 999px;
	}

	.hero {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
		align-items: center;
		margin-bottom: 3rem;
	}

	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.8rem;
		font-weight: 600;
		color: #6366f1;
		margin: 0 0 0.5rem;
	}

	h1 {
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		line-height: 1.2;
		margin: 0 0 1rem;
		color: #0f172a;
	}

	.lead {
		font-size: 1.05rem;
		color: #475569;
		margin: 0;
	}

	code {
		background: #f1f5f9;
		padding: 0.15rem 0.4rem;
		border-radius: 4px;
		font-size: 0.9em;
		color: #6366f1;
	}

	.hero-image {
		width: 100%;
		height: auto;
		border-radius: 16px;
		box-shadow: 0 8px 30px rgba(99, 102, 241, 0.15);
	}

	.topics {
		margin-bottom: 3rem;
	}

	h2 {
		font-size: 1.35rem;
		margin: 0 0 1.25rem;
		color: #0f172a;
	}

	.topic-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25rem;
	}

	.topic-card {
		background: white;
		border: 1px solid #e2e8f0;
		border-radius: 16px;
		padding: 1.5rem;
		text-align: center;
		transition: transform 0.2s, box-shadow 0.2s;
	}

	.topic-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 12px 24px rgba(15, 23, 42, 0.08);
	}

	.topic-card img {
		margin-bottom: 0.75rem;
	}

	.topic-card h3 {
		margin: 0 0 0.5rem;
		font-size: 1.1rem;
	}

	.topic-card p {
		margin: 0;
		font-size: 0.9rem;
		color: #64748b;
	}

	.tips {
		background: linear-gradient(135deg, #eef2ff 0%, #faf5ff 100%);
		border-radius: 16px;
		padding: 1.75rem 2rem;
		margin-bottom: 2.5rem;
	}

	.tips ul {
		margin: 0;
		padding-left: 1.25rem;
	}

	.tips li {
		margin-bottom: 0.75rem;
		color: #334155;
	}

	.tips li:last-child {
		margin-bottom: 0;
	}

	.footer {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid #e2e8f0;
	}

	.footer a {
		color: #6366f1;
		text-decoration: none;
		font-weight: 500;
	}

	.footer a:hover {
		text-decoration: underline;
	}

	@media (max-width: 768px) {
		.hero {
			grid-template-columns: 1fr;
		}

		.hero-image {
			order: -1;
		}

		.topic-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
