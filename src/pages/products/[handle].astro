<script>
	import { addToCart } from '../../scripts/cart';

	const main = document.getElementById('gallery-main');
	const thumbs = document.querySelectorAll('.gallery-thumb');
	const lightbox = document.querySelector('[data-lightbox]');
	const lightboxImg = document.querySelector('[data-lightbox-img]');
	const lightboxOpen = document.querySelector('[data-lightbox-open]');
	const lightboxClose = document.querySelector('[data-lightbox-close]');
	const addBtn = document.querySelector('[data-add-to-cart]');
	const feedback = document.querySelector('[data-cart-feedback]');

	thumbs.forEach((thumb) => {
		thumb.addEventListener('click', () => {
			const src = thumb.getAttribute('data-gallery-src');
			const alt = thumb.getAttribute('data-gallery-alt');
			const fit = thumb.getAttribute('data-gallery-fit') || 'cover';
			if (!main || !src) return;

			main.setAttribute('src', src);
			main.setAttribute('data-fit', fit);
			if (alt) main.setAttribute('alt', alt);

			thumbs.forEach((btn) => {
				btn.classList.remove('is-active');
				btn.setAttribute('aria-pressed', 'false');
			});
			thumb.classList.add('is-active');
			thumb.setAttribute('aria-pressed', 'true');
		});
	});

	const openLightbox = () => {
		if (!(lightbox instanceof HTMLDialogElement) || !(lightboxImg instanceof HTMLImageElement)) return;
		const src = lightboxOpen?.getAttribute('data-lightbox-src');
		const alt = lightboxOpen?.getAttribute('data-lightbox-alt') || '';
		if (!src) return;
		lightboxImg.src = src;
		lightboxImg.alt = alt;
		lightbox.showModal();
	};

	const closeLightbox = () => {
		if (lightbox instanceof HTMLDialogElement) lightbox.close();
	};

	lightboxOpen?.addEventListener('click', openLightbox);
	lightboxClose?.addEventListener('click', closeLightbox);
	lightbox?.addEventListener('click', (event) => {
		if (event.target === lightbox) closeLightbox();
	});

	addBtn?.addEventListener('click', () => {
		if (!(addBtn instanceof HTMLElement)) return;
		const sizeInput = document.querySelector<HTMLInputElement>('input[name="size"]:checked');
		const size = sizeInput?.value || 'One Size';
		let price = Number(addBtn.dataset.price || '0');
		let merchandiseId: string | undefined;

		try {
			const variants = JSON.parse(addBtn.dataset.variants || '[]') as Array<{
				id: string;
				size: string;
				price: number;
			}>;
			const match = variants.find((variant) => variant.size === size) || variants[0];
			if (match) {
				merchandiseId = match.id;
				price = match.price;
			}
		} catch {
			/* local products may have no variants */
		}

		addToCart({
			handle: addBtn.dataset.handle || '',
			title: addBtn.dataset.title || 'Product',
			size,
			price,
			currencyCode: 'GBP',
			imageSrc: addBtn.dataset.image || '',
			imageAlt: addBtn.dataset.imageAlt || '',
			merchandiseId,
			quantity: 1,
		});

		if (feedback instanceof HTMLElement) {
			feedback.hidden = false;
			feedback.textContent = `Added ${size} to cart — view cart when you’re ready.`;
		}
	});
</script>
