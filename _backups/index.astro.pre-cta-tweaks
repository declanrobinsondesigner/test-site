<script>
	const poisonGrid = document.getElementById('poison-grid');
	if (poisonGrid) {
		const cards = Array.from(poisonGrid.children);
		for (let i = cards.length - 1; i > 0; i -= 1) {
			const j = Math.floor(Math.random() * (i + 1));
			[cards[i], cards[j]] = [cards[j], cards[i]];
		}
		for (const card of cards) {
			poisonGrid.appendChild(card);
		}
	}

	const suggestionForm = document.getElementById('suggestion-form');
	const suggestionFeedback = document.getElementById('suggestion-feedback');

	suggestionForm?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const suggestionField = suggestionForm.querySelector('#suggestion');
		const nameField = suggestionForm.querySelector('#suggestion-name');
		const emailField = suggestionForm.querySelector('#suggestion-email');
		const suggestion = suggestionField?.value?.trim();
		const name = nameField?.value?.trim() || '';
		const email = emailField?.value?.trim() || '';
		if (!suggestion) return;

		const btn = suggestionForm.querySelector('.btn');
		const previous = btn?.textContent || "Chuck It In";
		if (btn) {
			btn.textContent = 'Sending…';
			btn.setAttribute('disabled', 'true');
		}

		try {
			const response = await fetch('/api/suggestion', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ suggestion, name, email }),
			});
			const data = await response.json();
			if (!response.ok || !data.ok) {
				throw new Error(data.message || 'Could not send suggestion.');
			}
			suggestionForm.classList.add('is-sent');
			if (btn) btn.textContent = 'Sent — Thanks';
			if (suggestionFeedback) {
				suggestionFeedback.hidden = false;
				suggestionFeedback.className = 'form-feedback is-ok';
				suggestionFeedback.textContent = 'Got it — we’ll have a look.';
			}
			suggestionForm.reset();
		} catch (error) {
			if (btn) {
				btn.textContent = previous;
				btn.removeAttribute('disabled');
			}
			if (suggestionFeedback) {
				suggestionFeedback.hidden = false;
				suggestionFeedback.className = 'form-feedback is-err';
				suggestionFeedback.textContent =
					error instanceof Error ? error.message : 'Something went wrong — try again.';
			}
		}
	});

	const newsletterForm = document.getElementById('newsletter-form');
	const newsletterFeedback = document.getElementById('newsletter-feedback');

	newsletterForm?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const emailField = newsletterForm.querySelector('#email');
		const email = emailField?.value?.trim();
		if (!email) return;

		const btn = newsletterForm.querySelector('.btn');
		const previous = btn?.textContent || "I'm In";
		if (btn) {
			btn.textContent = 'Joining…';
			btn.setAttribute('disabled', 'true');
		}

		try {
			const response = await fetch('/api/newsletter', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ email }),
			});
			const data = await response.json();
			if (!response.ok || !data.ok) {
				throw new Error(data.message || 'Could not join the list.');
			}
			if (btn) btn.textContent = "You're On The List";
			newsletterForm.classList.add('is-sent');
			if (newsletterFeedback) {
				newsletterFeedback.hidden = false;
				newsletterFeedback.className = 'form-feedback is-ok';
				newsletterFeedback.textContent = 'Welcome aboard — watch your inbox for drops.';
			}
			newsletterForm.reset();
		} catch (error) {
			if (btn) {
				btn.textContent = previous;
				btn.removeAttribute('disabled');
			}
			if (newsletterFeedback) {
				newsletterFeedback.hidden = false;
				newsletterFeedback.className = 'form-feedback is-err';
				newsletterFeedback.textContent =
					error instanceof Error ? error.message : 'Something went wrong — try again.';
			}
		}
	});
</script>
